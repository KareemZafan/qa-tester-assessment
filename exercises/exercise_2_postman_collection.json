{
  "info": {
    "_postman_id": "00000000-0000-0000-0000-000000000000",
    "name": "Exercise 2 — Auth & Coins API Flow",
    "description": "Chained Postman collection for the Auth & Coins API flow.\n\nFlow: Login → Get User → Join Room → Send Gift → Assert balance updated.\n\nAll URLs use {{base_url}}. Auth token captured from login response and auto-attached via collection-level pre-request script.\n\nIncludes JSON schema validation, business-logic assertions, and a negative-test folder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Happy Path Flow",
      "item": [
        {
          "name": "1. Login (Sanctum)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Skip collection-level auth for login (no token yet)"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response time < 1500ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1500);",
                  "});",
                  "",
                  "pm.test('Response matches login schema', function () {",
                  "    const schema = {",
                  "        type: 'object',",
                  "        required: ['token', 'user'],",
                  "        properties: {",
                  "            token: { type: 'string', minLength: 1 },",
                  "            user: {",
                  "                type: 'object',",
                  "                required: ['id', 'email', 'name'],",
                  "                properties: {",
                  "                    id: { type: 'integer' },",
                  "                    email: { type: 'string', format: 'email' },",
                  "                    name: { type: 'string' }",
                  "                }",
                  "            }",
                  "        }",
                  "    };",
                  "    pm.response.to.have.jsonSchema(schema);",
                  "});",
                  "",
                  "pm.test('Token is non-empty and captured', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "    pm.environment.set('auth_token', json.token);",
                  "});",
                  "",
                  "pm.test('Content-Type is application/json', function () {",
                  "    pm.response.to.have.header('Content-Type', 'application/json');",
                  "});",
                  "",
                  "pm.test('Returned email matches login email', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.user.email).to.eql(pm.environment.get('email'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticates with Sanctum and captures the bearer token into {{auth_token}} for all subsequent requests. Validates response schema, non-empty token, and that the returned user email matches the login email."
          },
          "response": []
        },
        {
          "name": "2. Get Current User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response time < 1500ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1500);",
                  "});",
                  "",
                  "pm.test('Response matches user schema', function () {",
                  "    const schema = {",
                  "        type: 'object',",
                  "        required: ['id', 'name', 'email', 'wallet'],",
                  "        properties: {",
                  "            id: { type: 'integer' },",
                  "            name: { type: 'string' },",
                  "            email: { type: 'string' },",
                  "            wallet: {",
                  "                type: 'object',",
                  "                required: ['balance'],",
                  "                properties: {",
                  "                    balance: { type: 'integer', minimum: 0 }",
                  "                }",
                  "            }",
                  "        }",
                  "    };",
                  "    pm.response.to.have.jsonSchema(schema);",
                  "});",
                  "",
                  "pm.test('Capture user_id and pre_balance for downstream requests', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.id).to.be.a('number');",
                  "    pm.environment.set('user_id', json.id);",
                  "    pm.environment.set('pre_gift_balance', json.wallet.balance);",
                  "});",
                  "",
                  "pm.test('Email matches authenticated user', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.email).to.eql(pm.environment.get('email'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/me",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "me"]
            },
            "description": "Fetches the current authenticated user profile. Captures user_id and wallet balance (pre_gift_balance) for downstream assertions. Auth header is auto-attached by the collection-level pre-request script."
          },
          "response": []
        },
        {
          "name": "3. Join Room",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response time < 1500ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1500);",
                  "});",
                  "",
                  "pm.test('Response matches join-room schema', function () {",
                  "    const schema = {",
                  "        type: 'object',",
                  "        required: ['room_id', 'joined', 'audience_count'],",
                  "        properties: {",
                  "            room_id: { type: 'integer' },",
                  "            joined: { type: 'boolean' },",
                  "            audience_count: { type: 'integer', minimum: 1 }",
                  "        }",
                  "    };",
                  "    pm.response.to.have.jsonSchema(schema);",
                  "});",
                  "",
                  "pm.test('User is confirmed joined to the room', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.joined).to.be.true;",
                  "    pm.expect(json.room_id).to.eql(parseInt(pm.environment.get('room_id')));",
                  "});",
                  "",
                  "pm.test('Audience count is at least 1 (includes current user)', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.audience_count).to.be.at.least(1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"room_id\": {{room_id}}\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/rooms/join",
              "host": ["{{base_url}}"],
              "path": ["api", "rooms", "join"]
            },
            "description": "Joins the specified room. Asserts the user is confirmed as joined and the audience count is valid. This must succeed before sending a gift."
          },
          "response": []
        },
        {
          "name": "4. Send Gift (with audience bonus)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Generate a fresh UUID v4 for idempotency_key",
                  "pm.environment.set('idempotency_key', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response time < 1500ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1500);",
                  "});",
                  "",
                  "pm.test('Response matches send-gift schema', function () {",
                  "    const schema = {",
                  "        type: 'object',",
                  "        required: ['transaction_id', 'coins_charged', 'winners', 'remaining_balance'],",
                  "        properties: {",
                  "            transaction_id: { type: 'integer' },",
                  "            coins_charged: { type: 'integer', minimum: 1 },",
                  "            winners: {",
                  "                type: 'array',",
                  "                items: {",
                  "                    type: 'object',",
                  "                    required: ['user_id', 'coins_awarded'],",
                  "                    properties: {",
                  "                        user_id: { type: 'integer' },",
                  "                        coins_awarded: { type: 'integer', minimum: 0 }",
                  "                    }",
                  "                }",
                  "            },",
                  "            remaining_balance: { type: 'integer', minimum: 0 }",
                  "        }",
                  "    };",
                  "    pm.response.to.have.jsonSchema(schema);",
                  "});",
                  "",
                  "pm.test('Winners array length matches requested winners_count', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.winners.length).to.eql(5);",
                  "});",
                  "",
                  "pm.test('Balance decreased by exact charge amount', function () {",
                  "    const json = pm.response.json();",
                  "    const preBalance = parseInt(pm.environment.get('pre_gift_balance'));",
                  "    pm.expect(json.remaining_balance).to.eql(preBalance - json.coins_charged);",
                  "});",
                  "",
                  "pm.test('Coins charged equals quantity * gift price', function () {",
                  "    const json = pm.response.json();",
                  "    // quantity=10, gift_id=7 (price defined server-side)",
                  "    // We verify charge is positive and consistent with remaining_balance",
                  "    pm.expect(json.coins_charged).to.be.above(0);",
                  "});",
                  "",
                  "pm.test('Transaction ID is captured for idempotency replay test', function () {",
                  "    const json = pm.response.json();",
                  "    pm.environment.set('transaction_id', json.transaction_id);",
                  "    pm.environment.set('post_gift_balance', json.remaining_balance);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"room_id\": {{room_id}},\n  \"gift_id\": {{gift_id}},\n  \"quantity\": 10,\n  \"winners_count\": 5,\n  \"idempotency_key\": \"{{idempotency_key}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/gifts/send",
              "host": ["{{base_url}}"],
              "path": ["api", "gifts", "send"]
            },
            "description": "Sends a gift with audience bonus. Pre-request script generates a fresh UUID v4 for idempotency. Asserts: correct schema, winners array length matches winners_count, balance decreased by exact charge, coins_charged is positive. Captures transaction_id and post-gift balance."
          },
          "response": []
        },
        {
          "name": "5. Verify Balance After Gift",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Wallet balance matches post-gift expected balance', function () {",
                  "    const json = pm.response.json();",
                  "    const expectedBalance = parseInt(pm.environment.get('post_gift_balance'));",
                  "    pm.expect(json.wallet.balance).to.eql(expectedBalance);",
                  "});",
                  "",
                  "pm.test('Balance is lower than pre-gift balance', function () {",
                  "    const json = pm.response.json();",
                  "    const preBalance = parseInt(pm.environment.get('pre_gift_balance'));",
                  "    pm.expect(json.wallet.balance).to.be.below(preBalance);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/me",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "me"]
            },
            "description": "Re-fetches user profile to independently verify the wallet balance was actually deducted server-side (not just returned in the gift response). Compares against pre_gift_balance and post_gift_balance captured in earlier requests."
          },
          "response": []
        }
      ],
      "description": "End-to-end happy path: Login → Get User (capture balance) → Join Room → Send Gift → Verify balance was deducted."
    },
    {
      "name": "Negative Tests",
      "item": [
        {
          "name": "N1. Expired/Invalid Token → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Response time < 1500ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1500);",
                  "});",
                  "",
                  "pm.test('Error message indicates auth failure', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.message).to.be.a('string');",
                  "    pm.expect(json.message.toLowerCase()).to.include('unauthenticated');",
                  "});",
                  "",
                  "pm.test('No sensitive data leaked in error response', function () {",
                  "    const body = pm.response.text();",
                  "    pm.expect(body).to.not.include('stack');",
                  "    pm.expect(body).to.not.include('Exception');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer expired-invalid-token-12345" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/me",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "me"]
            },
            "description": "Sends a request with an expired/invalid bearer token. Expects 401 with an error message. Verifies no stack trace or sensitive data is leaked."
          },
          "response": []
        },
        {
          "name": "N2. Send Gift with Invalid Quantity → 422",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 422 Unprocessable Entity', function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "",
                  "pm.test('Response time < 1500ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1500);",
                  "});",
                  "",
                  "pm.test('Validation error references quantity field', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('errors');",
                  "    pm.expect(json.errors).to.have.property('quantity');",
                  "});",
                  "",
                  "pm.test('Error message schema is correct', function () {",
                  "    const schema = {",
                  "        type: 'object',",
                  "        required: ['message', 'errors'],",
                  "        properties: {",
                  "            message: { type: 'string' },",
                  "            errors: {",
                  "                type: 'object',",
                  "                properties: {",
                  "                    quantity: {",
                  "                        type: 'array',",
                  "                        items: { type: 'string' }",
                  "                    }",
                  "                }",
                  "            }",
                  "        }",
                  "    };",
                  "    pm.response.to.have.jsonSchema(schema);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"room_id\": {{room_id}},\n  \"gift_id\": {{gift_id}},\n  \"quantity\": -5,\n  \"winners_count\": 5,\n  \"idempotency_key\": \"{{$guid}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/gifts/send",
              "host": ["{{base_url}}"],
              "path": ["api", "gifts", "send"]
            },
            "description": "Sends a gift with invalid quantity (-5, below the minimum of 1). Expects 422 with a validation error referencing the quantity field. Uses the authenticated token from collection-level pre-request."
          },
          "response": []
        },
        {
          "name": "N3. Send Gift with No Auth → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('No wallet deduction occurs (verified by re-checking balance after)', function () {",
                  "    // This assertion documents the expectation —",
                  "    // a follow-up GET /users/me would confirm balance unchanged.",
                  "    pm.expect(pm.response.code).to.eql(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"room_id\": {{room_id}},\n  \"gift_id\": {{gift_id}},\n  \"quantity\": 10,\n  \"winners_count\": 5,\n  \"idempotency_key\": \"{{$guid}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/gifts/send",
              "host": ["{{base_url}}"],
              "path": ["api", "gifts", "send"]
            },
            "description": "Attempts to send a gift with no auth header at all. Expects 401. Money-movement endpoints must never allow unauthenticated access."
          },
          "response": []
        }
      ],
      "description": "Negative test cases: expired token, invalid quantity, missing auth. Each verifies the API rejects bad input with correct status codes and error messages."
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level pre-request: auto-attach Bearer token to every request",
          "// EXCEPT the login request (which has auth type 'noauth').",
          "const noAuthRequests = ['1. Login (Sanctum)', 'N1. Expired/Invalid Token → 401', 'N3. Send Gift with No Auth → 401'];",
          "const requestName = pm.info.requestName;",
          "",
          "if (!noAuthRequests.includes(requestName)) {",
          "    const token = pm.environment.get('auth_token');",
          "    if (token) {",
          "        pm.request.headers.add({",
          "            key: 'Authorization',",
          "            value: 'Bearer ' + token",
          "        });",
          "    }",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level test: runs after every request.",
          "",
          "pm.test('Response time is acceptable (< 3000ms)', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(3000);",
          "});",
          "",
          "pm.test('Content-Type header is present', function () {",
          "    pm.response.to.have.header('Content-Type');",
          "});",
          "",
          "pm.test('No server error (5xx)', function () {",
          "    pm.expect(pm.response.code).to.be.below(500);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "{{base_url}}",
      "type": "string"
    }
  ]
}
